{
  "name": "signalk-yey-connector",
  "version": "0.1.0",
  "description": "Connect this SignalK server to yey.boats — a plan-driven, outbound-only cloud uplink.",
  "main": "index.js",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yey-boats/signalk-yey-connector.git"
  },
  "files": [
    "index.js",
    "lib",
    "public",
    "package.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-timeout=60000 test/e2e/*.test.js",
    "test:contract": "node --test test/contract.test.js",
    "check": "node --check index.js && npm test",
    "loadrig": "node loadrig/run.js",
    "build:config": "webpack"
  },
  "signalk": {
    "displayName": "yey — cloud connector"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3",
    "ws": "^8.18.0"
  },
  "homepage": "https://yey.boats/setup?source=plugin",
  "bugs": {
    "url": "https://github.com/yey-boats/signalk-yey-connector/issues"
  },
  "devDependencies": {
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  }
}
